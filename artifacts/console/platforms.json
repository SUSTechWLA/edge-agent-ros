  "test": {
    "method": "Live ROS 2 publisher in each isolated hardware Compose project; query core GetMission service; submit HTTP status request through the console proxy, retrieve persisted task and API state. Before input, request an unavailable image and verify diagnostic and non-retryability; pause another status request with zero automatic retries, restore odometry, request resume on its original step and verify a single dispatch.",
    "inputs": "150 synthetic stamped odometry/IMU pairs approximately 40 ms apart, x=0.002*i metres, wz=0.06 rad/s, laser frame every third pair, 7 ranges [1,2,+inf,1.4,2.2,1.8,1.6] m. Dispatch status at i=90. No Gazebo or motion controller in either project.",
    "get_mission_request": "unknown-status-only",
    "get_mission_expected_found": false,
    "timestamp_encoding": "stamp_ns is a decimal string in this evidence file. On both platforms, API stamp.sec * 10^9 + stamp.nanosec matched the original integer stamp_ns exactly.",
    "source_sha256": {
      "agent/planning.py": "617087e08a178b842ae2e69a7f43e28b3312f0aec63ce453061486ee5fd77640",
      "agent/service.py": "9651e24e5eb5286e65fe140aaf8c85e865c5b0509ced4199ad785deefd823c3a",
      "console/server/observations.py": "16255e7d133c7d041655ff8f08a2061447804579211fd35f5d9b1b66c5b95144",
      "console/web/app.js": "45567f73b7de51e5b97ab0fdcd543f6b49121ce971b0c51f12eab716a557ba17"
    },
    "extra_observations": "Run python3 /opt/edge/console/server/test_observations.py -v on each target in an isolated ROS_DOMAIN_ID. Manifest is added, sensor_msgs/msg/Range is published, silence makes it stale, publishing restores it, hot-removal releases the ROS subscription; assert durable replay and bounded message preview."
  },
