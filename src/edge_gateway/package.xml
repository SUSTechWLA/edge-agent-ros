  <maintainer email="maintainers@example.invalid">Edge Agent ROS developers</maintainer>
  <license>Unspecified</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>edge_interfaces</depend>
  <depend>geometry_msgs</depend>
