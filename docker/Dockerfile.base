FROM ros:jazzy-ros-base
# Optional distribution mirrors; keep the base image's signing keys. An ARM64
# Ubuntu mirror must carry ubuntu-ports rather than the amd64 Ubuntu archive.
ARG UBUNTU_MIRROR
ARG ROS_MIRROR
RUN if [ -n "$UBUNTU_MIRROR" ]; then \
      sed -i "s|^URIs: .*|URIs: $UBUNTU_MIRROR|" /etc/apt/sources.list.d/ubuntu.sources; \
    fi && \
    if [ -n "$ROS_MIRROR" ]; then \
      sed -i -e "s|^URIs: .*|URIs: $ROS_MIRROR|" -e 's/^Types: deb deb-src$/Types: deb/' /etc/apt/sources.list.d/ros2.sources; \
    fi && \
    apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
    build-essential cmake python3-colcon-common-extensions libsqlite3-dev \
    ros-jazzy-ros-gz-sim ros-jazzy-ros-gz-bridge ros-jazzy-rmw-cyclonedds-cpp \
    ros-jazzy-rclcpp-action ros-jazzy-rosidl-default-generators ros-jazzy-nav-msgs \
    && rm -rf /var/lib/apt/lists/*
