<?xml version="1.0"?>
<sdf version="1.9">
  <world name="edge_lab">
    <physics name="lab_physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <pose>0 0 5 0 0 0</pose><direction>-0.5 0.4 -1</direction>
      <diffuse>0.95 0.94 0.9 1</diffuse>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="floor">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><diffuse>0.75 0.78 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Landmarks outside the +/-4 m mission envelope. Both rendering and
         physics see the same boxes; the perception node only sees LaserScan. -->
    <model name="north_wall">
      <static>true</static><pose>0 4.65 0.55 0 0 0</pose>
      <link name="wall">
        <visual name="paint"><geometry><box><size>9.5 0.18 1.1</size></box></geometry></visual>
        <collision name="solid"><geometry><box><size>9.5 0.18 1.1</size></box></geometry></collision>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>4.65 1.35 0.55 0 0 0</pose>
      <link name="wall">
        <visual name="paint"><geometry><box><size>0.18 6.5 1.1</size></box></geometry></visual>
        <collision name="solid"><geometry><box><size>0.18 6.5 1.1</size></box></geometry></collision>
      </link>
    </model>
    <model name="south_rack">
      <static>true</static><pose>-1.9 -4.85 0.6 0 0 0</pose>
      <link name="rack">
        <visual name="paint"><geometry><box><size>2.6 0.6 1.2</size></box></geometry></visual>
        <collision name="solid"><geometry><box><size>2.6 0.6 1.2</size></box></geometry></collision>
      </link>
    </model>
    <model name="edge_rover" canonical_link="base_link">
      <!-- The model origin is at the wheel axle centre. The chassis centre of
           mass lies behind it so the two drive wheels and caster share load. -->
      <pose>0 0 0.101 0 0 0</pose>
      <link name="base_link">
        <sensor name="imu" type="imu">
          <always_on>true</always_on><update_rate>50</update_rate>
          <topic>/imu</topic><gz_frame_id>imu_link</gz_frame_id>
        </sensor>
        <sensor name="horizontal_lidar" type="gpu_lidar">
          <pose>0.08 0 0.20 0 0 0</pose>
          <always_on>true</always_on><update_rate>8</update_rate>
          <topic>/scan</topic><gz_frame_id>laser_link</gz_frame_id>
          <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159265</min_angle><max_angle>3.12413936</max_angle>
          </horizontal></scan><range><min>0.10</min><max>8</max><resolution>0.01</resolution></range></lidar>
        </sensor>
        <inertial>
          <pose>-0.055 0 0.015 0 0 0</pose>
          <mass>2.5</mass><inertia><ixx>0.0175</ixx><iyy>0.039</iyy><izz>0.053</izz></inertia>
        </inertial>
        <collision name="body">
          <pose>-0.055 0 0.015 0 0 0</pose>
          <geometry><box><size>0.42 0.28 0.10</size></box></geometry>
        </collision>
        <visual name="body">
          <pose>-0.055 0 0.015 0 0 0</pose>
          <geometry><box><size>0.42 0.28 0.10</size></box></geometry>
          <material><diffuse>0.05 0.55 0.45 1</diffuse></material>
        </visual>
      </link>
      <link name="left_wheel">
        <pose>0 0.18 0 -1.57079632679 0 0</pose>
        <inertial><mass>0.25</mass><inertia><ixx>0.00067</ixx><iyy>0.00067</iyy><izz>0.00125</izz></inertia></inertial>
        <!-- Centred contact patch models a rounded tread, avoiding the contact
             solver selecting a cylinder rim as the pivot during turns. -->
        <collision name="tyre"><geometry><sphere><radius>0.10</radius></sphere></geometry></collision>
        <visual name="tyre"><geometry><cylinder><radius>0.10</radius><length>0.045</length></cylinder></geometry></visual>
      </link>
      <link name="right_wheel">
        <pose>0 -0.18 0 -1.57079632679 0 0</pose>
        <inertial><mass>0.25</mass><inertia><ixx>0.00067</ixx><iyy>0.00067</iyy><izz>0.00125</izz></inertia></inertial>
        <collision name="tyre"><geometry><sphere><radius>0.10</radius></sphere></geometry></collision>
        <visual name="tyre"><geometry><cylinder><radius>0.10</radius><length>0.045</length></cylinder></geometry></visual>
      </link>
      <link name="rear_caster">
        <pose>-0.23 0 -0.055 0 0 0</pose>
        <inertial><mass>0.08</mass><inertia><ixx>0.000065</ixx><iyy>0.000065</iyy><izz>0.000065</izz></inertia></inertial>
        <collision name="ball">
          <geometry><sphere><radius>0.045</radius></sphere></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name="ball"><geometry><sphere><radius>0.045</radius></sphere></geometry></visual>
      </link>
      <joint name="left_axle" type="revolute">
        <parent>base_link</parent><child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>
      <joint name="right_axle" type="revolute">
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>
      <joint name="caster_mount" type="ball">
        <parent>base_link</parent><child>rear_caster</child>
      </joint>
      <plugin filename="edge_velocity_watchdog" name="edge_sim::VelocityWatchdog"/>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_axle</left_joint><right_joint>right_axle</right_joint>
        <wheel_separation>0.36</wheel_separation><wheel_radius>0.10</wheel_radius>
        <topic>/edge_rover/guarded_cmd_vel</topic><odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <!-- The acceptance probe sees Gazebo world pose, independently of the
           DiffDrive plugin's wheel odometry used by the controller. -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_topic>/ground_truth</odom_topic><odom_frame>world</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <dimensions>2</dimensions><odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
