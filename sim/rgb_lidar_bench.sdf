<?xml version="1.0"?>
<sdf version="1.9">
  <world name="fusion_bench">
    <physics name="fixed_step" type="ignored"><max_step_size>0.01</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.4 0.4 0.4 1</ambient><background>0.13 0.14 0.16 1</background></scene>
    <light name="illumination" type="directional"><pose>0 0 5 0 0 0</pose><direction>0.7 0 -0.7</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0 0 0 1</specular><cast_shadows>false</cast_shadows></light>
    <!-- Fixed measuring rig, metres in world. Gazebo's camera looks along world +X. -->
    <model name="rig"><static>true</static>
      <link name="mount">
        <sensor name="rgbd" type="rgbd_camera">
          <pose>0.08 0 0.85 0 0 0</pose><always_on>true</always_on><update_rate>5</update_rate>
          <topic>/fusion/rgbd</topic><gz_frame_id>rgbd_optical</gz_frame_id>
          <camera><horizontal_fov>1.3962634</horizontal_fov><optical_frame_id>rgbd_optical</optical_frame_id>
            <image><width>320</width><height>200</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>9</far></clip><camera_info_topic>/fusion/rgbd/camera_info</camera_info_topic>
          </camera>
        </sensor>
        <sensor name="lidar_left" type="gpu_lidar">
          <pose>0 0.31 0.75 0 0 0.18</pose><always_on>true</always_on><update_rate>5</update_rate>
          <topic>/fusion/lidar_left</topic><gz_frame_id>lidar_left</gz_frame_id>
          <lidar><scan>
            <horizontal><samples>161</samples><resolution>1</resolution><min_angle>-0.93</min_angle><max_angle>0.93</max_angle></horizontal>
            <vertical><samples>51</samples><resolution>1</resolution><min_angle>-0.5</min_angle><max_angle>0.45</max_angle></vertical>
          </scan><range><min>0.10</min><max>9</max><resolution>0.002</resolution></range></lidar>
        </sensor>
        <sensor name="lidar_right" type="gpu_lidar">
          <pose>0 -0.29 0.99 0 0 -0.16</pose><always_on>true</always_on><update_rate>5</update_rate>
          <topic>/fusion/lidar_right</topic><gz_frame_id>lidar_right</gz_frame_id>
          <lidar><scan>
            <horizontal><samples>161</samples><resolution>1</resolution><min_angle>-0.93</min_angle><max_angle>0.93</max_angle></horizontal>
            <vertical><samples>51</samples><resolution>1</resolution><min_angle>-0.5</min_angle><max_angle>0.45</max_angle></vertical>
          </scan><range><min>0.10</min><max>9</max><resolution>0.002</resolution></range></lidar>
        </sensor>
      </link>
    </model>
    <model name="red_wall"><static>true</static><pose>4.06 1.7 1.25 0 0 0</pose><link name="surface">
      <visual name="paint"><geometry><box><size>0.12 1.7 2.5</size></box></geometry>
        <material><ambient>0.65 0.016 0.016 1</ambient><diffuse>0.65 0.016 0.016 1</diffuse><emissive>0.65 0.016 0.016 1</emissive></material>
      </visual>
      <collision name="body"><geometry><box><size>0.12 1.7 2.5</size></box></geometry></collision>
    </link></model>
    <model name="green_wall"><static>true</static><pose>4.06 0 1.25 0 0 0</pose><link name="surface">
      <visual name="paint"><geometry><box><size>0.12 1.7 2.5</size></box></geometry>
        <material><ambient>0.016 0.65 0.016 1</ambient><diffuse>0.016 0.65 0.016 1</diffuse><emissive>0.016 0.65 0.016 1</emissive></material>
      </visual>
      <collision name="body"><geometry><box><size>0.12 1.7 2.5</size></box></geometry></collision>
    </link></model>
    <model name="blue_wall"><static>true</static><pose>4.06 -1.7 1.25 0 0 0</pose><link name="surface">
      <visual name="paint"><geometry><box><size>0.12 1.7 2.5</size></box></geometry>
        <material><ambient>0.016 0.016 0.65 1</ambient><diffuse>0.016 0.016 0.65 1</diffuse><emissive>0.016 0.016 0.65 1</emissive></material>
      </visual>
      <collision name="body"><geometry><box><size>0.12 1.7 2.5</size></box></geometry></collision>
    </link></model>
    <model name="yellow_post"><static>true</static><pose>1.95 0.32 0.85 0 0 0</pose><link name="surface">
      <visual name="paint"><geometry><box><size>0.3 0.27 1.7</size></box></geometry>
        <material><ambient>0.65 0.65 0.016 1</ambient><diffuse>0.65 0.65 0.016 1</diffuse><emissive>0.65 0.65 0.016 1</emissive></material>
      </visual>
      <collision name="body"><geometry><box><size>0.3 0.27 1.7</size></box></geometry></collision>
    </link></model>
    <model name="magenta_crate"><static>true</static><pose>2.8 -1.07 0.44 0 0 0</pose><link name="surface">
      <visual name="paint"><geometry><box><size>0.55 0.69 0.88</size></box></geometry>
        <material><ambient>0.65 0.016 0.65 1</ambient><diffuse>0.65 0.016 0.65 1</diffuse><emissive>0.65 0.016 0.65 1</emissive></material>
      </visual>
      <collision name="body"><geometry><box><size>0.55 0.69 0.88</size></box></geometry></collision>
    </link></model>
    <model name="cyan_side"><static>true</static><pose>2.55 2.42 0.92 0 0 0</pose><link name="surface">
      <visual name="paint"><geometry><box><size>2.4 0.13 1.84</size></box></geometry>
        <material><ambient>0.016 0.65 0.65 1</ambient><diffuse>0.016 0.65 0.65 1</diffuse><emissive>0.016 0.65 0.65 1</emissive></material>
      </visual>
      <collision name="body"><geometry><box><size>2.4 0.13 1.84</size></box></geometry></collision>
    </link></model>
    <model name="floor"><static>true</static><pose>2.3 0 -0.05 0 0 0</pose><link name="surface">
      <visual name="paint"><geometry><box><size>7.0 7.5 0.1</size></box></geometry>
        <material><ambient>0.29 0.29 0.29 1</ambient><diffuse>0.29 0.29 0.29 1</diffuse><emissive>0.29 0.29 0.29 1</emissive></material>
      </visual>
      <collision name="body"><geometry><box><size>7.0 7.5 0.1</size></box></geometry></collision>
    </link></model>
  </world>
</sdf>
