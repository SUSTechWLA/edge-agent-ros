<sdf version="1.9">
  <model name="edge_rgbd_station">
    <static>true</static>
    <pose>-1.4 -1.0 1.1 0 0 0</pose>
    <link name="tripod">
      <sensor name="rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>3</update_rate>
        <topic>/edge/rgbd_station</topic>
        <gz_frame_id>edge_rgbd_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.08</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.15</near><far>8.0</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
