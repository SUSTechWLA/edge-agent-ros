<?xml version="1.0"?>
<sdf version="1.9">
  <model name="edge_map3d_survey"><static>true</static><pose>0 0 1.2 0 0 0</pose>
    <link name="station">
      <sensor name="scan3d" type="gpu_lidar">
        <always_on>true</always_on><update_rate>3</update_rate>
        <topic>/edge/map3d/survey</topic><gz_frame_id>map3d_survey</gz_frame_id>
        <lidar><scan>
          <horizontal><samples>160</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.10232275</max_angle></horizontal>
          <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.75</min_angle><max_angle>0.65</max_angle></vertical>
        </scan><range><min>0.25</min><max>12</max><resolution>0.01</resolution></range></lidar>
      </sensor>
    </link>
  </model>
</sdf>
