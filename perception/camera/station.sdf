<sdf version="1.9"><model name="edge_camera_station"><static>true</static><pose>-2 0 1.1 0 0.1 0</pose><link name="tripod">
  <sensor name="front_rgb" type="camera"><always_on>true</always_on><update_rate>4</update_rate>
    <topic>/edge/cameras/front/image</topic><gz_frame_id>edge_camera_front</gz_frame_id>
    <camera><camera_info_topic>/edge/cameras/front/camera_info</camera_info_topic><horizontal_fov>1.2</horizontal_fov>
      <image><width>320</width><height>240</height><format>R8G8B8</format></image>
      <clip><near>0.05</near><far>30</far></clip></camera>
  </sensor></link></model></sdf>
